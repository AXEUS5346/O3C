{
  "name": "o3c",
  "version": "0.2.0",
  "description": "Claude Code bridge for OpenCode free models: dynamic catalog, real context, streaming, and Claude harness mapping.",
  "type": "module",
  "bin": {
    "claude-opencode": "bin/claude-opencode.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "install:o3c": "node scripts/install.mjs",
    "test": "node --test test/translate.test.mjs test/install.test.mjs",
    "test:translate": "node --test test/translate.test.mjs",
    "test:install": "node --test test/install.test.mjs",
    "test:direct": "bash test/e2e.sh",
    "test:service": "bash test/e2e-service.sh",
    "test:launcher": "bash test/e2e-launcher.sh",
    "test:live": "bash test/live-smoke.sh"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AXEUS5346/O3C.git"
  },
  "homepage": "https://github.com/AXEUS5346/O3C#readme",
  "bugs": {
    "url": "https://github.com/AXEUS5346/O3C/issues"
  },
  "keywords": [
    "claude-code",
    "opencode",
    "anthropic",
    "bridge",
    "free-models",
    "streaming"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
